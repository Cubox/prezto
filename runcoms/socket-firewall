# Socket Firewall Free wrappers.
# Installed with: bun install -g sfw or npm install -g sfw.

if [ -d "$HOME/.bun/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.bun/bin:"*) ;;
    *) export PATH="$HOME/.bun/bin:$PATH" ;;
  esac
fi

if ! command -v sfw >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
fi

if command -v sfw >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    _sfw_package_managers=(
      npm yarn pnpm bun
      pip uv
      cargo
    )
  else
    _sfw_package_managers="
      npm yarn pnpm bun
      pip uv
      cargo
    "
  fi

  for _sfw_pm in $_sfw_package_managers; do
    eval "function ${_sfw_pm}() { command sfw ${_sfw_pm} \"\$@\"; }"
  done

  unset _sfw_pm _sfw_package_managers
fi
