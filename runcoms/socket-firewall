# Socket Firewall Free wrappers.
# Installed with: bun install -g sfw

case ":$PATH:" in
  *":$HOME/.bun/bin:"*) ;;
  *) export PATH="$HOME/.bun/bin:$PATH" ;;
esac

if command -v sfw >/dev/null 2>&1; then
  if [ -n "$ZSH_VERSION" ]; then
    _sfw_package_managers=(
      npm yarn pnpm bun
      pip uv
      cargo
    )
  else
    _sfw_package_managers="
      npm yarn pnpm bun
      pip uv
      cargo
    "
  fi

  for _sfw_pm in $_sfw_package_managers; do
    eval "function ${_sfw_pm}() { command sfw ${_sfw_pm} \"\$@\"; }"
  done

  unset _sfw_pm _sfw_package_managers
fi
