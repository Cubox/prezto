#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Fix zsh

setopt MULTIOS
setopt EXTENDED_GLOB
setopt INTERACTIVECOMMENTS
unsetopt CLOBBER
unsetopt CORRECT
unsetopt AUTO_CD CDABLE_VARS
unalias rm 2>/dev/null
unalias scp 2>/dev/null

if [[ -z "$HOSTNAME" ]]; then
    HOSTNAME=$(hostname)
fi

# Various exports for me

if [[ "$HOSTNAME" == "Akimed.local" ]]; then
    if [[ -z $SSH_AUTH_SOCK ]]; then
	export SSH_AUTH_SOCK="~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    fi
    # Scaleway CLI autocomplete initialization.
    eval "$(scw autocomplete script shell=zsh)"

    export PATH="/Users/andypilate/.local/bin:$PATH"
fi

if [[ "$TERM" == "screen" ]] || [[ "$TERM" == "xterm" ]]; then
    export TERM="$TERM-256color"
fi

if [[ "$HOSTNAME" == "Vagabond" ]]; then
    PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH"
    . "$HOME/.local/bin/env"
fi

alias tmux="tmux -2"
alias cpaste="curl -F 'content=<-' https://paste.cubox.dev"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

if [[ -n "$AGENT" ]]; then
    unset HISTFILE
fi
if [[ -s "$HOME/.safe-chain/scripts/init-posix.sh" ]]; then
    source "$HOME/.safe-chain/scripts/init-posix.sh"
fi
